# Turso Cloud Database Credentials (JANGAN commit file .env asli)
# Vite hanya membaca variabel berprefix VITE_ di frontend.
VITE_TURSO_DATABASE_URL="libsql://your-database.turso.io"
VITE_TURSO_AUTH_TOKEN="your-turso-auth-token"
# Alias lama yang juga didukung vite.config.ts:
# DATABASE_URL="libsql://your-database.turso.io"
# TOKEN_TURSO="your-turso-auth-token"
# PENTING: token frontend = publik. Pakai token read-only / short-lived
# untuk produksi + rotasi berkala. Revoke token yang pernah ter-commit.

# Google Gemini API Key (Fitur Voice AI Kasir Otomatis)
# Dapatkan API Key gratis di https://aistudio.google.com/
VITE_GEMINI_API_KEY="your-gemini-api-key-here"
